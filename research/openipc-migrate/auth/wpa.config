# Trial only: WPA2-PSK/CCMP is enforced again in the generated network configuration.
# No enterprise EAP, TLS methods, WPS, SAE, P2P, AP mode, or control socket is enabled.
# The default entropy pool is deliberately retained.
CONFIG_DRIVER_NL80211=y
CONFIG_DRIVER_WEXT=y
CONFIG_LIBNL_TINY=y
CONFIG_L2_PACKET=linux
CONFIG_TLS=internal
CONFIG_CRYPTO=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_NO_CONFIG_WRITE=y
CONFIG_NO_CONFIG_BLOBS=y
CONFIG_NO_TKIP=y
CONFIG_NO_RC4=y
CONFIG_NO_WPA_PASSPHRASE=y
CONFIG_NO_ROAMING=y
CONFIG_NO_RRM=y
CONFIG_NO_WMM_AC=y
CONFIG_NO_ROBUST_AV=y
CONFIG_NO_STDOUT_DEBUG=y
CONFIG_NO_GITVER=y