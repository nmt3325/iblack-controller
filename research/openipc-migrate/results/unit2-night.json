  "findings": {
    "source": "stock cmsMain reverse engineering (BoardType 0x63002601), then checked on the camera",
    "ircut": {
      "gpio": 2,
      "pin": "GPIO0_2",
      "drive": "single pin, level held",
      "day": 1,
      "night": 0,
      "majestic": "irCutPin1: 2 with irCutSingleInvert: true (majestic drives day low by default)"
    },
    "ir_led": {
      "gpio": 52,
      "pin": "GPIO6_4",
      "on": 1,
      "pad_mux": {
        "reg": "0x200F0090",
        "default": 1,
        "default_function": "SDIO data0",
        "gpio": 0
      },
      "majestic": "backlightPin: 52; majestic switches the pad to GPIO when it starts (checked by setting 1 and restarting)"
    },
    "light_sensor": {
      "type": "photoresistor",
      "adc_channel": 1,
      "device": "/dev/ADC_CH1 (misc 10,43, open_adc)",
      "direction": "higher reading = brighter",
      "adc_channel0": "not connected, reads 10-60",
      "sees_ir_led": "LED adds about 10 at dusk (89 off, 98-100 on) and gives 14 in the dark (0-2 off)"
    },
    "majestic_adc": {
      "reads": "/dev/ADC_CH0 only",
      "workaround": "S94lightsensor links /dev/ADC_CH0 to ADC_CH1 before S95majestic",
      "check": "night_adc_raw matched a direct read of /dev/ADC_CH1"
    },
    "thresholds_with_adcInvert": {
      "night_when": "adc < minThreshold",
      "day_when": "adc > maxThreshold",
      "between": "keeps the current mode",
      "check_interval_s": 5,
      "autoNightDelay_autoDayDelay": "not applied in ADC mode (switch within one check)"
    },
    "manual_while_automatic": "/night/off at night was undone by the next check (about 5 s) because the reading stayed below minThreshold",
    "gpio0_5": "output high (Wi-Fi/USB power); not touched"
  },
