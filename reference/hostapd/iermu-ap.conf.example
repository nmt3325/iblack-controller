# Dedicated Wi-Fi AP for the iermu camera (started by iermu-ap.service)
interface=wlp1s0
driver=nl80211
ctrl_interface=/run/hostapd
ctrl_interface_group=0
ssid=iermu-cam
country_code=JP
ieee80211d=1
hw_mode=g
channel=11
beacon_int=100
dtim_period=2
max_num_sta=4
ieee80211n=1
ht_capab=[SHORT-GI-20]
wmm_enabled=1
auth_algs=1
ignore_broadcast_ssid=0
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
wpa_passphrase=REPLACE_AP_WIFI_PSK
ieee80211w=0
macaddr_acl=1
accept_mac_file=/etc/hostapd/iermu-ap.accept
disassoc_low_ack=0
ap_max_inactivity=600
logger_syslog=0
logger_stdout=-1
logger_stdout_level=2
