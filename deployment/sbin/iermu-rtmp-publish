#!/bin/bash
set -euo pipefail
cd /home/nmt3325/iermu_cam
export LD_LIBRARY_PATH=/home/nmt3325/diga-playback/ffmpeg/lib
# Never send a camera pull through an unrelated default route.
while ! /usr/local/sbin/iermu-home-uplink-guard --check; do
  echo "Waiting for the direct home-camera Wi-Fi route." >&2
  sleep 10
done
./camera-stream 86400 | /home/nmt3325/diga-playback/ffmpeg/bin/ffmpeg   -hide_banner -loglevel warning -nostdin -fflags +genpts -i pipe:0   -map 0:v:0 -map 0:a:0 -c:v copy -c:a copy -avoid_negative_ts make_zero   -flvflags no_duration_filesize -f flv rtmp://100.87.20.49:1935/live/camera
