#!/bin/bash
# Addresses + NAT for the dedicated camera AP on wlp1s0 (idempotent).
IF=wlp1s0; WAN=ens18; NET=192.168.10.0/24
ip addr replace 192.168.10.1/24 dev "$IF"
ip addr replace 192.168.10.24/24 dev "$IF"
sysctl -qw net.ipv4.ip_forward=1
iptables -C FORWARD -i "$IF" -o "$WAN" -j ACCEPT 2>/dev/null || iptables -I FORWARD 1 -i "$IF" -o "$WAN" -j ACCEPT
iptables -C FORWARD -i "$WAN" -o "$IF" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || iptables -I FORWARD 1 -i "$WAN" -o "$IF" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
iptables -t nat -C POSTROUTING -s "$NET" -o "$WAN" -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s "$NET" -o "$WAN" -j MASQUERADE
exit 0
