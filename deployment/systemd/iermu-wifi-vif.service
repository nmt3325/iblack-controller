[Unit]
Description=Prepare the physical home-camera Wi-Fi station
Requires=NetworkManager.service sys-subsystem-net-devices-wlp1s0.device
After=NetworkManager.service sys-subsystem-net-devices-wlp1s0.device
Before=iermu-ap.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/iermu-wifi-vif-up
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
