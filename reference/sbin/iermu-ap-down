#!/bin/bash
# Undo iermu-ap-up.
IF=wlp1s0; WAN=ens18; NET=192.168.10.0/24
while iptables -D FORWARD -i "$IF" -o "$WAN" -j ACCEPT 2>/dev/null; do :; done
while iptables -D FORWARD -i "$WAN" -o "$IF" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null; do :; done
while iptables -t nat -D POSTROUTING -s "$NET" -o "$WAN" -j MASQUERADE 2>/dev/null; do :; done
ip addr del 192.168.10.24/24 dev "$IF" 2>/dev/null
ip addr del 192.168.10.1/24 dev "$IF" 2>/dev/null
exit 0
